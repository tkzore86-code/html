<html>
    <head>
        <title>my animal safari</title>
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
        <style>
        body {position: relative;}
        .safari-slide {height: 200px; text-align: center; padding-top: 75px; font-size: 1.8rem; color: white;}
        .slide-forest { background: darkgreen;}
        .slide-oceans { background: steelblue;}
        .slide-desert { background: orange;}
        .section { padding: 70px 20px; min-height: 300px;}
        #forest {background: honeydew;}
        #ocean { background: aliceblue;}
        #desert { background: lightyellow;}
        </style>
    </head>
    <body data-spy="scroll" data-target="#safarinav" dataoffset="60">
     <div id="safaricarousel" class="carousel slide" data-ride="carousel">
     <ol class="carousel-indicators">
        <li data-target="#safaricarousel" data-slide-to="0" class="active"></li>
        <li data-target="#safaricarousel" data-slide-to="1"></li>
        <li data-target="#safaricarousel" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active safari-slide slide-forest">🌳forest safari</div>
            <div class="carousel-item safari-slide slide-oceans">🌊 oceans safari</div>
            <div class="carousel-item safari-slide slide-desert">🏜️ desert safari</div>
        </div>
        <a class="carousel-control-prev" href="#safaricarousel" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </a>
        <a class="carousel-control-next" href="#safaricarousel" data-slide="next">
            <span class="carousel-control-next-icon"></span>
        </a>
     </div>
     <nav id="safarinav" class="navbar navbar-expand-sm navbar-dark bg-dark sticky-top">
            <span class="navbar-brand">🏜️safari guide</span>
     </nav>