}
.section-light{
background-color: #f4f4f4;
color: #666;
}
.section-dark{
background-color: #282e34;
color: #ddd;
}
.ptext{
position: absolute;
top: 50%;
width: 100%;
text-align: center;
color: #000;
font-size: 27px;
letter-spacing: 8px;
text-transform: uppercase;
}
.ptext .border{
background-color: #111;
color: #fff;
padding: 20px;
}
.ptext .border .trans{
background-color: transparent;
}
@media(max-width:568px){
.pimg1, .pimg2, .pimg3{
background-attachment: scroll;
}
}
</style>
</head>
