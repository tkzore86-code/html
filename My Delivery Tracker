<html>
<head>
<title>My Delivery Tracker</title>
<style>
body {
font-family: Arial, sans-serif;
background: aliceblue;
text-align: center;
padding: 30px;
}
h1{color: #ff5a43;}
button{
background: #ff5a43;
color: white;
padding: 10px 20px;
border: none;
border-radius: 20px;
cursor: pointer;
margin: 5px;
}
div{
border: 1px solid #ff5a43;
width: 280px;
margin: 6px auto;
padding: 8px 12px;
text-align: left;
border-radius: 6px;
}
</style>
</head>
<body>
<h1>My Delivery Tracker</h1>
<button onclick="saveorder()">save order</button>
<button onclick="startdelivery()">start delivery</button>
<div>json text:<span id="json-text"></span></div>
<div>loaded item:<span id="loaded-item"></span></div>
<div>loaded price:<span id="loaded price"></span></div>
<div>status:<span id="status"></span></div>
<div>result:<span id="result"></span></div>
<script>
let order={
item:"pizza",
price: 5,
shop: "my snack shop"
};
function saveorder() {
let jsontext=json.stringify(order);
let loadedorder=json.parse(jsontext);
document.getElementById("json-text").innerHTML=jsontext;
document.getElementById("loaded-item").innerHTML = loadedorder.item;
document.getElementById("loaded-price").innerHTML = "$" + loadedorder.price;
}
function delay(ms){
return new promise(function(resolve) {
settimeout(resolve,ms)
});
}
async function startdelivery(){
document.getElementById("result").innerHTML="";
document.getElementById("status").innerHTML = "order received!";
settimeout(function(){
document.getElementById("status").innerHTML = "kitchen is preparing...";
},1000);
await delay(3000);
document.getElementById("status").innerHTML = "out for delivery!";
await delay(2000);
document.getElementById("result").innerHTML = "your order has arrived!";
}
</script>
</body>
</html>